# Copy to ~/.draaiboek/env and fill in. chmod 600.
# Blank values are skipped -- a partial setup works.
# NEVER commit a filled-in copy of this file.

# ClickUp -- Settings > Apps > API Token
CLICKUP_TOKEN=
CLICKUP_TEAM_ID=

# Missive -- Settings > API
MISSIVE_TOKEN=

# Xero -- developer.xero.com.
# The refresh token rotates on EVERY use; the code rewrites this file in place.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REFRESH_TOKEN=
XERO_TENANT_ID=

# Google -- path to the service-account key JSON, and the mailbox to read.
GOOGLE_CREDENTIALS=~/.draaiboek/google_service_account.json
GOOGLE_IMPERSONATE=<mailbox to read>

# Documents
DRAAIBOEK_TEMPLATE_DOC_ID=
DRAAIBOEK_SANDBOX_DOC_ID=
DRAAIBOEK_DRIVE_FOLDER_ID=

# Set this to serve the workspace to other machines. Without it, local only.
DRAAIBOEK_UI_KEY=

# Larissa's chat history, so any agent can read what she has decided.
DRAAIBOEK_MEMORY_URL=http://100.88.127.17:8001
DRAAIBOEK_MEMORY_PEER=peer_Larissa_Groeneveld
